    # 测试：两个人课表
    person1 = [("高数",1,"08:00","09:45"),("俄语",2,"14:00","15:45")]
    person2 = [("物理",1,"10:00","11:45"),("计算机",2,"08:00","09:45")]
    res = calc_common_free([person1, person2])
    for item in res:
        print(f"星期{item['weekday']} {item['start']}~{item['end']} 时长：{item['minutes']}分钟")